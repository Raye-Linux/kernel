+static const struct font_desc *drm_panic_user_font(struct drm_scanout_buffer *sb,
+						   bool large)
+{
+	const struct font_desc *font = NULL;
+
+	if (large && sb->width >= 1280)
+		font = find_font("TER16x32");
+	if (!font)
+		font = find_font("VGA8x16");
+	if (!font)
+		font = get_default_font(sb->width, sb->height, NULL, NULL);
+	return font;
+}
+
+/* Raye: centre @lines horizontally at height @y, cut at the screen bottom */
+static unsigned int drm_panic_draw_lines(struct drm_scanout_buffer *sb,
+					 const struct font_desc *font,
+					 const struct drm_panic_line *lines,
+					 unsigned int count, unsigned int y, u32 color)
+{
+	unsigned int width = min(get_max_line_len(lines, count) * font->width, sb->width);
+	unsigned int height = count * font->height;
+	struct drm_rect r;
+
+	if (y >= sb->height)
+		return y;
+	height = min(height, sb->height - y);
+	if (height < font->height)
+		return y + height;
+
+	r = DRM_RECT_INIT((sb->width - width) / 2, y, width, height);
+	draw_txt_rectangle(sb, font, lines, count, true, &r, color);
+	return y + height;
+}
