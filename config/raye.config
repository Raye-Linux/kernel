# Raye on top of Ubuntu's generic configuration: only what makes the
# Raye kernel different. Everything else stays exactly Ubuntu's, apart
# from what the compiler decides (build.sh builds with Clang, Ubuntu with
# GCC).

# the crash screen in Raye colours: night violet, light text
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="user"
CONFIG_DRM_PANIC_FOREGROUND_COLOR=0xf3eaff
CONFIG_DRM_PANIC_BACKGROUND_COLOR=0x2a1052

# the crash screen picture (the eye and the words in Inter) is the mono
# logo; build.sh points CONFIG_LOGO_LINUX_MONO_FILE at assets/raye-crash.pbm.
# The patch keeps it off the screen at start-up.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_MONO=y
# CONFIG_LOGO_LINUX_VGA16 is not set
# CONFIG_LOGO_LINUX_CLUT224 is not set

# the two console fonts the crash screen uses (already on in Ubuntu's)
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# the crash screen says the computer restarts by itself: it does, after
# 30 seconds, even without panic=30 on the command line
CONFIG_PANIC_TIMEOUT=30

# What games, Wine and Proton count on. Ubuntu's generic config has all of
# it already (read from 7.0.0-43.43); it is written down so that build.sh
# stops if a later Ubuntu kernel drops or changes one of them.

# 1000 Hz tick and lazy preemption; preempt=full measured no better
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_LAZY=y
# sched_ext, for the scheduler game mode loads (scx_lavd needs BTF and the JIT)
CONFIG_SCHED_CLASS_EXT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_JIT=y
CONFIG_SCHED_AUTOGROUP=y
# Wine 11 sync objects, and futex_waitv for Proton's fsync
CONFIG_NTSYNC=m
CONFIG_FUTEX=y
CONFIG_FUTEX_PRIVATE_HASH=y
# huge pages only for programs that ask (madvise)
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# kernel.split_lock_mitigate exists only with this
CONFIG_X86_BUS_LOCK_DETECT=y
# CPU frequency: amd-pstate and intel_pstate in active mode
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_X86_INTEL_PSTATE=y
# I/O: none for NVMe, mq-deadline for SATA SSDs, bfq for spinning disks
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=m
CONFIG_ZRAM=m
# Steam's runtime (user namespaces, seccomp) and Steam Input
CONFIG_USER_NS=y
CONFIG_SECCOMP_FILTER=y
CONFIG_INPUT_UINPUT=y
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_STEAM=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_JOYSTICK_XPAD=m

# BORE on top of EEVDF (patches/0005). kernel.sched_bore=0 turns it off
# at run time. The slice floor is BORE's own default, written down so a
# change of it shows.
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=2000000

# Clang and LLD with ThinLTO. build.sh passes LLVM=-<n> to every make,
# n being the Clang Ubuntu's own source asks for; without it these four
# lines do not take and build.sh stops. Rust cannot be on together with
# LTO and BTF (sched_ext needs BTF), so it goes: the only Rust driver
# Ubuntu builds is the QT2025 PHY of Tehuti TN40xx 10G cards.
CONFIG_CC_IS_CLANG=y
CONFIG_LD_IS_LLD=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
# CONFIG_RUST is not set
